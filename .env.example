# SMTP — mailbox that SENDS consultation emails
# Gmail OAuth2 is recommended. Keep these values server-side only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=falkevininteriors@gmail.com

# Recommended: Gmail OAuth2
SMTP_AUTH=oauth2
SMTP_CLIENT_ID=your-client-id.apps.googleusercontent.com
SMTP_CLIENT_SECRET=your-client-secret
SMTP_REFRESH_TOKEN=your-refresh-token

# Alternative: password/App Password authentication
# Set SMTP_AUTH=password and remove/comment the OAuth2 values above.
# SMTP_PASS=your-app-password-or-smtp-password

# Optional display name for the From header
SMTP_FROM="Falkevin Interior Designers <falkevininteriors@gmail.com>"

# Inbox that RECEIVES new consultation leads (your address)
CONTACT_TO_EMAIL=falkevininteriors@gmail.com
